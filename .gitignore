# Dependencies
node_modules/

# Build output
dist/
dist-ssr/

# Local env files — never commit Clerk or Supabase keys
.env
.env.local
.env.*.local

# Editor / OS cruft
.DS_Store
.vscode/
.idea/
*.swp

# Logs
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*

# Vercel
.vercel
.claude/launch.json
# The reference paper and its sidecars are FETCHED, not committed:
# `npm run paper:fetch` puts them here and papersFor() only offers the paper
# under DEV. The pdf alone was ignored, so the sidecar folder beside it sat as
# a permanent untracked entry in every `git status`.
public/papers/

# Playwright
tests/artifacts/
tests/report/
tests/screens/
tests/last-run.json

# ref-diff's own output and its saved sign-in — screenshots and a session cookie.
tools/ref-diff-out/
tools/.auth.json

# visual-diff's output — screenshots, regenerated on every run.
tools/diff/
tools/qa/

# Rows of deleted accounts: personal data, kept locally until the owner removes them.
backups/accounts-*/

# Local agent worktrees.
.claude/worktrees/
