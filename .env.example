# Copy to .env.local and fill in. .env.local is gitignored — keys never get committed.
#
# Clerk: Dashboard -> API Keys -> Publishable key. Starts pk_test_ or pk_live_.
VITE_CLERK_PUBLISHABLE_KEY=

# Supabase: Project Settings -> API.
# Use the anon/public key. Never the service_role key: it bypasses RLS, and
# anything in a VITE_ variable is compiled into the browser bundle.
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=
