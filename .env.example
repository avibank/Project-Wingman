# Copy to .env.local and fill in. .env.local is gitignored — keys never get committed.
#
# Clerk: Dashboard -> API Keys -> Publishable key. Starts pk_test_ or pk_live_.
VITE_CLERK_PUBLISHABLE_KEY=

# Supabase: Project Settings -> API.
#
# For the key, use a Publishable key (sb_publishable_...) from the
# "Publishable and secret API keys" tab, or the older anon key from the
# "Legacy anon, service_role API keys" tab. Either works.
#
# Never a Secret key (sb_secret_...) or service_role. Those bypass row level
# security, and anything in a VITE_ variable is compiled into the browser
# bundle and shipped to every visitor.
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=
