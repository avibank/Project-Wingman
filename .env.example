# Copy to .env.local and fill in. .env.local is gitignored — keys never get committed.
#
# ---------------------------------------------------------------- browser keys
# Anything named VITE_ is compiled into the bundle every visitor downloads.
# Only ever put publishable/public keys here.

# Clerk -> API Keys -> Publishable key. Starts pk_test_ or pk_live_.
VITE_CLERK_PUBLISHABLE_KEY=

# Supabase -> Project Settings -> API.
# Use a Publishable key (sb_publishable_...) from the "Publishable and secret
# API keys" tab, or the older anon key from the Legacy tab. Either works.
# Never a Secret key (sb_secret_...) or service_role: they bypass row level
# security, and this value ships to every visitor.
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# -------------------------------------------------------------- papers, paused
# The papers reader is paused. Unset or anything other than `true` means there
# are no papers anywhere in the app: no Library section, no Pages bookmarks, no
# paper passages in chat, and /m/:module/paper/:id is an ordinary 404. Nothing
# is deleted — the code, the tables and every mark and bookmark stay exactly
# where they are, and this one variable brings all of it back.
#
# Default off on purpose, in production, in CI and locally, so nothing quietly
# depends on it being on. Read in exactly one place: `papersOn` in
# src/lib/flags.js.
VITE_PAPERS_READER=

# ------------------------------------------------------------ admin-only keys
# Deliberately NOT named VITE_, so the build cannot pick them up. These are used
# only by the scripts in scripts/, which run on your machine. Treat both as
# passwords.

# Supabase -> Project Settings -> Database -> Connection string (URI).
# Contains your database password. Needed for `npm run sql`, which creates
# tables and functions — the publishable key cannot do that.
SUPABASE_DB_URL=

# Clerk -> API Keys -> Secret key (sk_...). Can read and change every user in
# the instance. Needed for `npm run clerk`.
CLERK_SECRET_KEY=
